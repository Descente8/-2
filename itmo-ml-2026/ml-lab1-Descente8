        "### BEGIN YOUR CODE\n",
        "\n",
        "from sklearn.cluster import KMeans\n",
        "\n",
        "n_clusters = 3\n",
        "\n",
        "kmeans = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)\n",
        "clusters = kmeans.fit_predict(df_standart)\n",
        "\n",
        "centers = kmeans.cluster_centers_\n",
        "distances = np.linalg.norm(\n",
        "    df_standart.to_numpy() - centers[clusters],\n",
        "    axis=1\n",
        ")\n",
        "\n",
        "fig, axes = plt.subplots(1, n_clusters, figsize=(15, 4))\n",
        "\n",
        "for cluster in range(n_clusters):\n",
        "    cluster_distances = distances[clusters == cluster]\n",
        "\n",
        "    axes[cluster].hist(cluster_distances, bins=15, edgecolor='black')\n",
        "    axes[cluster].set_title(f'Cluster {cluster}')\n",
        "    axes[cluster].set_xlabel('Distance to centroid')\n",
        "    axes[cluster].set_ylabel('Frequency')\n",
        "\n",
        "plt.tight_layout()\n",
        "\n",
        "\n",
        "kmeans_outlier_mask = np.zeros(len(df_standart), dtype=bool)\n",
        "\n",
        "for cluster in range(n_clusters):\n",
        "    cluster_mask = clusters == cluster\n",
        "    threshold = np.percentile(distances[cluster_mask], 95)\n",
        "\n",
        "    kmeans_outlier_mask |= cluster_mask & (distances > threshold)\n",
        "\n",
        "keep_indices = df_standart.index[~kmeans_outlier_mask]\n",
        "\n",
        "df_filtered_kmeans = pd.concat(\n",
        "    [\n",
        "        df_standart.loc[keep_indices],\n",
        "        df_ohe.loc[keep_indices]\n",
        "    ],\n",
        "    axis=1\n",
        ")\n",
        "\n",
        "### END YOUR CODE"
